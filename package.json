{
  "name": "dsh-my-go",
  "version": "0.6.0",
  "description": "多智能体编排预设：主编（Sisyphus）调度 + 内置工种名册 + 报告落板；星型嵌套 + 双泳道池化编排（读/写双池各自计数）、按工种绑定模型，含 go_work/continue/need_help/forward 通信工具、Web UI 树状图面板与设置页。",
  "author": "Tisitan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tisitan/dsh-my-go.git"
  },
  "bugs": {
    "url": "https://github.com/Tisitan/dsh-my-go/issues"
  },
  "homepage": "https://github.com/Tisitan/dsh-my-go#readme",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "agent",
    "orchestration",
    "sisyphus",
    "subagent",
    "multi-agent"
  ],
  "engines": {
    "node": ">=22.15"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./dist/client.js",
    "./preset/tools/broker.mjs": "./preset/tools/broker.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "dist",
    "scripts",
    "prompts",
    "preset",
    "docs",
    "!docs/legacy-broker-ts",
    "!docs/archive",
    "README.md",
    "CHANGELOG.md",
    "AGENTS.md",
    "LICENSE",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "build:client": "node scripts/build-client.mjs",
    "lint": "eslint .",
    "dump:session": "node scripts/dump-session.mjs",
    "typecheck:archive": "tsc --noEmit",
    "test": "node scripts/build-client.mjs && node test/apply.mjs && node --test \"test/**/*.test.mjs\""
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./preset/agent.patch.yml"
      ]
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": ">=0.1.7-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-client-locale": ">=0.1.7-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.7-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.1.7-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-settings": ">=0.1.7-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-subagent": ">=0.1.7-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.1.7-alpha.1 <0.3.0",
    "react": "^18.2.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.3",
    "@deepseek-ai/dsh-agent": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-llm": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-subagent": "^0.1.7-alpha.1",
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "js-yaml": "^4.1.0",
    "typescript": "^5.6.0"
  }
}
